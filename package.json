{
  "name": "dsh-pdf-math-desk",
  "version": "0.36.3",
  "private": false,
  "type": "module",
  "description": "A full-page math workbench organized by book and chapter.",
  "keywords": [
    "dsh-plugin",
    "math",
    "pdf",
    "latex"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/minggemofashi/dsh-pdf-math-desk.git"
  },
  "homepage": "https://github.com/minggemofashi/dsh-pdf-math-desk",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./docs/*": "./docs/*",
    "./docs/DETAIL.md": "./docs/DETAIL.md",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "vendor",
    "tools",
    "samples",
    "market",
    "assets",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "screenshots.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "安装与分发.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT"
}
