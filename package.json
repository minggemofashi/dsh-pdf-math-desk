{
  "name": "dsh-pdf-math-desk",
  "version": "0.33.2",
  "private": true,
  "type": "module",
  "description": "A full-page math workbench organized by book and chapter.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "vendor",
    "tools",
    "samples",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "安装与分发.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
