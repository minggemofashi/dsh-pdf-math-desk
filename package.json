{
  "name": "dsh-pdf-workbench",
  "version": "1.5.0",
  "private": false,
  "type": "module",
  "description": "PDF reading workbench for DSH: books and chapters, ask-as-you-read conversations, annotations, and a built-in pdf.js reader.",
  "keywords": [
    "dsh-plugin",
    "pdf",
    "reader",
    "annotation",
    "math",
    "latex"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/minggemofashi/dsh-pdf-workbench.git"
  },
  "homepage": "https://github.com/minggemofashi/dsh-pdf-workbench",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./docs/*": "./docs/*",
    "./docs/DETAIL.md": "./docs/DETAIL.md",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "vendor",
    "tools",
    "samples",
    "assets",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "screenshots.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "安装与分发.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "scripts": {
    "build:host-ui": "node scripts/build-host-ui.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT"
}
